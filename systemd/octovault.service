[Unit]
Description=OctoVault privileged vault and backup service
Documentation=https://github.com/octoleo/octovault
After=dbus.service

[Service]
Type=dbus
BusName=io.vdm.OctoVault1
ExecStart=/usr/libexec/octovault/daemon
# System services already default to root. Explicit User=root makes systemd
# 259's seccomp setup drop CAP_SETUID; NoNewPrivileges then prevents restoring
# it at exec. Workers need this capability to drop to the vault owner's UID.
Group=root
UMask=0077
LimitCORE=0
StateDirectory=octovault
StateDirectoryMode=0700
RuntimeDirectory=octovault
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
Restart=on-failure
RestartSec=3s
TimeoutStopSec=120s
# Tomb mounts must propagate to user sessions. Do not create a private mount
# namespace with PrivateTmp, ProtectSystem, ProtectHome, or PrivateDevices.
