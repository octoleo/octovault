#!/bin/sh
set -e

if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    case "$1" in
        upgrade|remove|deconfigure)
            if [ "$1" = upgrade ] && systemctl is-active --quiet octovault.service; then
                touch /run/octovault-package-restart
            fi
            for timer in /etc/systemd/system/octovault-backup-*.timer; do
                [ -f "$timer" ] || continue
                if [ "$1" = upgrade ]; then
                    systemctl stop "${timer##*/}" || true
                else
                    systemctl disable --now "${timer##*/}" || true
                fi
            done
            for worker in /etc/systemd/system/octovault-backup-*.service; do
                [ -f "$worker" ] || continue
                systemctl stop "${worker##*/}" || true
            done
            systemctl stop octovault.service || true
            ;;
    esac
fi

